# Doména pro docker-compose.yml s Caddy (automatické HTTPS), např. classmate.cz. Na CasaOS se nepoužívá.
DOMAIN=

# Tajný klíč pro šifrování uložených tokenů a klíčů (min. 32 náhodných znaků).
# Když chybí, vygeneruje se do data/.secret – ten soubor pak zálohuj spolu s databází.
APP_SECRET=
# Kam se ukládá SQLite databáze (výchozí ./data)
DATA_DIR=./data
# Cookies jen přes HTTPS (výchozí true v produkci). Nastav false, pokud běžíš přes http v LAN.
COOKIE_SECURE=true

# Veřejná adresa aplikace (odkazy v pozvánkách a e-mailech, MCP / OAuth), např. https://classmate.cz
PUBLIC_URL=

# Jak často (v minutách) se na pozadí kontrolují změny v rozvrhu, nové známky a absence kvůli zprávám. 0 = vypnuto.

# Víc = rychlejší synchronizace, ale větší zátěž školních serverů. Výchozí 8 a 6.
# Další pojistky pro nápor: kolik převodů nahrávek (ffmpeg) a dotazů na AI smí běžet naráz a kolik MB musí zůstat volných na disku,
# aby se ještě přijímaly nahrávky, obrázky a přílohy. Výchozí 2, 6 a 1024.
FFMPEG_CONCURRENCY=2
AI_CONCURRENCY=6
DISK_MIN_FREE_MB=1024

# Web Push: noční klid, ve kterém se upozornění neposílají (od-do v hodinách, "off" = vypnuto)
PUSH_QUIET_HOURS=22-6

# Jak dlouho (ve dnech, nejméně 30) se drží audit log ve Správě (přihlášení, zásahy správce). Výchozí 365.
AUDIT_RETENTION_DAYS=365

# Kolik místa smí mít jeden uživatel na nahrávky z hodin (MB)
AUDIO_QUOTA_MB=2048
# Kolik místa smí mít jeden uživatel na přílohy poznámek (MB)
FILE_QUOTA_MB=1024
# Kolik místa smí mít jeden uživatel na obrázky v poznámkách (MB)
IMAGE_QUOTA_MB=500

CONTACT_EMAIL=

FEEDBACK_EMAIL=

# Volitelné: e-mailová upozornění (uživatel si je zapne v Nastavení). Bez SMTP_HOST a SMTP_FROM se e-maily neposílají.
# Port 465 = šifrované spojení hned, 587 = STARTTLS (výchozí).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Classmate <info@classmate.cz>
# Název poštovní služby (ukáže se v zásadách ochrany osobních údajů), např. Gmail nebo Seznam.cz
SMTP_PROVIDER_NAME=



# Volitelné: přihlášení přes Todoist (OAuth) v Nastavení → Propojení. Údaje z registrace aplikace na https://developer.todoist.com/appconsole.html, postup v DEPLOY.md. Bez nich jde Todoist propojit jen API tokenem.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Volitelně: instalační kód pro průvodce prvním spuštěním (doporučeno, dokud server není nastavený). Vymysli si cokoli, např. openssl rand -hex 12.
SETUP_TOKEN=

# Push do mobilní aplikace přes Firebase (volitelné): cesta k JSON účtu služby (mimo Docker).
# V Dockeru se soubor kopíruje do volume jako /data/.fcm.json, viz classmate-app (docs/FIREBASE.md).
# FCM_SERVICE_ACCOUNT=


# Ověření odkazů pro aplikaci Classmate na Androidu (/.well-known/assetlinks.json). Výchozí je oficiální klíč.
# Po vydání přes Google Play přidej otisk „App signing key“ z Play Console (SHA-256 s dvojtečkami, oddělené čárkami).
# ANDROID_APP_CERTS=
# ANDROID_APP_PACKAGE=cz.classmate.app

# Kdo tenhle server provozuje (správce osobních údajů): ukazuje se v zásadách ochrany osobních údajů a ve Správě.
OPERATOR_NAME=
OPERATOR_URL=

# Platba kartou (Stripe): poplatek za kartu platí student a pokladník dostane přesnou částku. Výchozí sazba je standardní karta z EHP (1,5 % + 6,50 Kč).
# Pozor: přirážka za kartu je v EHP u spotřebitelských karet podle PSD2 zakázaná, zapnutí je na odpovědnost provozovatele.
# STRIPE_PASS_FEE=0 poplatek nepřičítá (platba kartou je pak o poplatek menší). Aktuální sazby najdeš na stripe.com/cz/pricing.
STRIPE_PASS_FEE=1
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_CZK=6.5

# Veřejné demo: na přihlášení je odkaz „Vyzkoušet demo bez registrace“, každý návštěvník dostane vlastní třídu s vymyšlenými daty.

# Statistika návštěvnosti (vlastní Umami, docker-compose.stats.yml) se používá jen na úvodním webu; v aplikaci nech ANALYTICS_* prázdné.
# ANALYTICS_SRC=https://stats.classmate.cz/script.js
# ANALYTICS_WEBSITE_ID=
# Heslo databáze a tajný klíč Umami (jen pro docker-compose.stats.yml)
# STATS_DB_PASSWORD=
# STATS_SECRET=
