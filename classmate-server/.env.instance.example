# Samostatná instance Classmate. Každá instance má vlastní .env, vlastní databázi a vlastní tajné klíče; s ostatními nic nesdílí.

# Na jakém portu tohoto stroje instance poslouchá (uvnitř kontejneru je vždy 3000; na jednom stroji musí mít každá jiný, např. 3100, 3101, …). Cloudflare Tunnel nebo proxy míří sem.
HOST_PORT=3100

# Tajný klíč pro šifrování uložených tokenů (min. 32 náhodných znaků: openssl rand -base64 48). Po nasazení ho NEMĚŇ a zálohuj zvlášť.
APP_SECRET=

# Veřejná adresa téhle instance (pro odkazy v e-mailech, OAuth, MCP a mobilní aplikaci), např. https://aplikace.skola.cz
PUBLIC_URL=

# Instalační kód pro průvodce prvním spuštěním (/zprovozneni): kdo ho zná, vytvoří správce. Doporučeno, dokud server není nastavený.
SETUP_TOKEN=

# Kdo instanci provozuje: ukazuje se v zásadách ochrany osobních údajů (správce osobních údajů) a ve Správě.
OPERATOR_NAME=
OPERATOR_URL=
# Kam chodí zprávy z „Mám nápad“ a kontakt v zásadách (bez něj se zprávy ukládají jen ve Správě)
FEEDBACK_EMAIL=

# Odesílání e-mailů (potvrzení e-mailu, zapomenuté heslo, upozornění). Bez SMTP_HOST a SMTP_FROM se neposílají.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Classmate <classmate@example.cz>

# Volitelné: školní e-mail přes Microsoft 365 (vlastní aplikace v Microsoft Entra, viz DEPLOY.md)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Volitelné: přihlášení do Todoistu přes OAuth (vlastní aplikace na developer.todoist.com)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Volitelné: oznámení v mobilní aplikaci přes Firebase (účet služby JSON, cesta nebo samotný JSON). Klíče pro umělou inteligenci se zadávají ve Správě.
FCM_SERVICE_ACCOUNT=

# Jak často (min) se na pozadí hlídají změny v Bakalářích (0 = vypnuto)
BACKGROUND_SYNC_MINUTES=5

# Platba kartou (Stripe): poplatek za kartu platí student a pokladník dostane přesnou částku. Výchozí sazba je standardní karta z EHP (1,5 % + 6,50 Kč).
# Pozor: přirážka za kartu je v EHP u spotřebitelských karet podle PSD2 zakázaná, zapnutí je na odpovědnost provozovatele.
# STRIPE_PASS_FEE=0 poplatek nepřičítá (platba kartou je pak o poplatek menší). Aktuální sazby najdeš na stripe.com/cz/pricing.
STRIPE_PASS_FEE=1
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_CZK=6.5

# Strop paměti kontejneru a Node heapu (MB), podle RAM stroje (viz PRODUKCE.md): 2 GB RAM → 1536m a 1024, 4 GB → 2560m a 1536, 8 GB → 4g a 2560.
APP_MEMORY=1536m
NODE_HEAP_MB=1024

# Záloha mimo server: cíl rclone (nejlépe šifrovaný, "crypt") a adresa pro hlídání záloh (Healthchecks.io, Uptime Kuma). Používá scripts/backup.sh.
BACKUP_REMOTE=
BACKUP_PING_URL=
